{
  "info": {
    "name": "PharmaBackend S14 Autonoma",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Usar solo datos ficticios del esquema TIENDA existente en oracle-local2. Configurar las dos contrasenas localmente, sin guardarlas en Git. La venta 201 descuenta una unidad real de demostracion."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "adminUser",
      "value": "admin"
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "vendedorUser",
      "value": "vendedor"
    },
    {
      "key": "vendedorPassword",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "vendorToken",
      "value": ""
    },
    {
      "key": "productoId",
      "value": ""
    },
    {
      "key": "clienteId",
      "value": ""
    },
    {
      "key": "ventaId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Login admin",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"{{adminUser}}\", \"password\": \"{{adminPassword}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.collectionVariables.set(\"adminToken\", pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Login vendedor",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"{{vendedorUser}}\", \"password\": \"{{vendedorPassword}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.collectionVariables.set(\"vendorToken\", pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Productos paginados 200",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/productos?buscar=00%20S14%20Producto&tamanio=20",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.collectionVariables.set(\"productoId\", pm.response.json().content[0].id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Cliente demo 200",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/clientes?buscar=S14%20Demo&tamanio=20",
